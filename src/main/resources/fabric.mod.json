{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${mod_version}",
	"name": "Superflat Biome Extension",
	"description": "Adds a flat world type with regular biome distribution.",
	"authors": [
		"Miki Tellurium"
	],
	"contributors": [
		"Codfish789"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/superflat-biome-extension",
		"sources": "https://github.com/Miki-Tellurium/SuperflatBiomeExtension",
		"issues": "https://github.com/Miki-Tellurium/SuperflatBiomeExtension/issues"
	},
	"license": "MIT License",
	"icon": "assets/superflatbiomextension_logo.png",
	"environment": "*",
	"entrypoints": {
		"main": [
          "com.mikitellurium.superflatbiomeextension.SuperflatBiomeExtension"
		],
		"client" : [
			"com.mikitellurium.superflatbiomeextension.SuperflatBiomeExtensionClient"
		]
	},
	"mixins": [
		"${mod_id}.mixins.json"
	],
	"accessWidener" : "${mod_id}.accesswidener",
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"another-mod": "*"
	},
	"custom": {
		"${mod_id}:credits": [
			{
				"contributor": "Codfish789",
				"reason": "Most of the work of porting to MC 26.2 and adding more data packs support"
			}
		]
	}
}